{
  "name": "G Dark-Shader (Haiti)",
  "type": "light",
  "tokenColors": [{
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        // "fontStyle": "italic bold",
        "foreground": "#837594"
      }
    },
    {
      "name": "Docstring",
      "scope": [
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "fontStyle": "italic bold",
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#c5a0f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "PHP Constants, Variables Constants",
      "scope": [
        "constant.other.php",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ee6eff",
        "fontStyle": ""
      }
    },
    {
      "name": "PHP Constants, Constants",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ee6eff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#eb53ff"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#eb7ae1"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
      ],
      "settings": {
        "foreground": "#c792ea"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type",
      ],
      "settings": {
        "foreground": "#bc8aff"
      }
    },
    {
      "name": "Modifier",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b07fff",
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "Keyword",
        "Storage"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator, Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.section.embedded",
      ],
      "settings": {
        "foreground": "#c169fc"
      }
    },
    {
      "name": "php dollar sign",
      "scope": "punctuation.definition.variable.php",
      "settings": {
        "foreground": "#bb79fd"
      }
    },
    {
      "name": "Operator, Keyword",
      "scope": [
        "keyword.control",
        "constant.other.color",
        "keyword.other.template",
        "keyword.other.substitution",
        "punctuation.separator.inheritance.php",
      ],
      "settings": {
        "foreground": "#dd83f8"
      }
    },
    {
      "name": "Keyword Control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter",
        "punctuation.definition.tag.html",
      ],
      "settings": {
        "foreground": "#bb79fd"
      }
    },
    {
      "name": "Open-End Tag",
      "scope": [
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": {
        "foreground": "#9774b9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function",
      "scope": [
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#c081ff"
      }
    },
    {
      "name": "Special Method, Block Level",
      "scope": [
        "entity.name.function",
      ],
      "settings": {
        // "fontStyle": "",
        "foreground": "#bc8aff"
      }
    },
    {
      "name": "C-related Block Level Variables",
      "scope": [
        "source.cpp meta.block variable.other"
      ],
      "settings": {
        "foreground": "#9e67e6"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9e67e6"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.escape",
        "keyword.other.unit",
      ],
      "settings": {
        "foreground": "#ea8dfd"
      }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#d584e9"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name",
        "support.type",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter",
        "support.type.sys-types"
      ],
      "settings": {
        "foreground": "#ce85ff",
        // "fontStyle": "bold"
      }
    },
    {
      "name": "PHP Namespace",
      "scope": [
        "support.other.namespace.php"
      ],
      "settings": {
        "foreground": "#c169fc",
        // "fontStyle": "bold"
      }
    },
    {
      "name": "PHP Entity Namespace",
      "scope": [
        "entity.name"
      ],
      "settings": {
        "foreground": "#d56dff",
        // "fontStyle": "bold"
      }
    },
    {
      "name": "Support",
      "scope": [
        "support.class",
      ],
      "settings": {
        "foreground": "#e47bf7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Entity Types",
      "scope": [
        "support.type"
      ],
      "settings": {
        "foreground": "#da65fd"
      }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": {
        "foreground": "#ce85ff"
      }
    },
    {
      "name": "Sub-methods",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#e079ff"
      }
    },
    {
      "name": "Language methods",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e079ff"
      }
    },
    {
      "name": "entity.name.method.js",
      "scope": [
        "entity.name.method.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#da65fd"
      }
    },
    {
      "name": "meta.method.js",
      "scope": [
        "meta.class-method.js entity.name.function.js",
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#da65fd"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d56dff"
      }
    },
    {
      "name": "Vue/HTML attribute strings",
      "scope": [
        "text.html.vue string.quoted",
        "text.html.vue meta.attribute string.quoted",
        "meta.attribute.directive.vue string.quoted",
        "text.html.derivative string.quoted.double.html",
        "text.html.derivative string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#d584e9"
      }
    },
    {
      "name": "Vue directives and bound props",
      "scope": [
        "entity.other.attribute-name.vue",
        "meta.attribute.directive.vue entity.other.attribute-name",
        "punctuation.attribute-shorthand.bind.html.vue",
        "punctuation.attribute-shorthand.event.html.vue"
      ],
      "settings": {
        "foreground": "#b07fff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vue properties",
      "scope": [
        "text.html.vue variable.other.property",
        "text.html.vue variable.other.object.property",
        "text.html.vue meta.object-literal.key",
        "source.vue variable.other.property",
        "source.vue meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c5a0f5"
      }
    },
    {
      "name": "CSS Classes",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#c169fc"
      }
    },
    {
      "name": "CSS ID's",
      "scope": [
        "source.sass keyword.control",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#da65fd",
        // "fontStyle": "bold"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7ba9c4"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#eb7ae1"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#b085ff"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ee6eff"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e079ff"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*",
      ],
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#da65fd"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e47bf7"
      }
    },
    {
      "name": "ES7 Bind Operator",
      "scope": [
        "source.js constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e47bf7"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
