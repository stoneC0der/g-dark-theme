{
  "name": "G Dark-one-love (Black Pearl)",
  "type": "dark",
  "tokenColors": [
    // {
    //   "settings": {
    //     "foreground": "#1b7488"
    //   }
    // },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        // "fontStyle": "italic bold",
        "foreground": "#6e7a7d"
      }
    },
    {
      "name": "Docstring",
      "scope": [
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "fontStyle": "italic bold",
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#aeb89c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "PHP Constants, Variables Constant",
      "scope": [
        "constant.other.php",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#e9983b",
        "fontStyle": ""
      }
    },
    {
      "name": "Language Constants, Constants",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.other.color",
      ],
      "settings": {
        "foreground": "#e6a26b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Language methods",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#75cb75"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff788f"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#c792ea"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
      ],
      "settings": {
        "foreground": "#ff8c78"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type",
      ],
      "settings": {
        "foreground": "#e3d44d"
      }
    },
    {
      "name": "Modifier",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#80d850",
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "Keyword",
        "Storage"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator, Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.section.embedded",
      ],
      "settings": {
        "foreground": "#eb92ff"
      }
    },
    {
      "name": "php dollar sign",
      "scope": "punctuation.definition.variable.php",
      "settings": {
        "foreground": "#57c7b8"
      }
    },
    {
      "name": "Operator, Keyword",
      "scope": [
        "keyword.control",
        "constant.other.color",
        "keyword.other.template",
        "keyword.other.substitution",
        "punctuation.separator.inheritance.php",
      ],
      "settings": {
        "foreground": "#dc83ff"
      }
    },
    {
      "name": "Keyword Control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter",
        "punctuation.definition.tag.html"
      ],
      "settings": {
        "foreground": "#ff7d7d"
      }
    },
    {
      "name": "Open-End Tag",
      "scope": [
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": {
        "foreground": "#ff799c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function",
      "scope": [
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#31c1e4"
      }
    },
    {
      "name": "Special Method, Block Level, GitGutter changed",
      "scope": [
        "entity.name.function",
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#ff7daf"
      }
    },
    {
      "name": "C-related Block Level Variables",
      "scope": [
        "source.cpp meta.block variable.other"
      ],
      "settings": {
        "foreground": "#bcc7a8"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#bcc7a8"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.escape",
        "keyword.other.unit",
      ],
      "settings": {
        "foreground": "#f1aa62"
      }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#7dceac"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name",
        "support.type",
        "markup.changed.git_gutter",
        "support.type.sys-types"
      ],
      "settings": {
        "foreground": "#ffcb6bf3",
        // "fontStyle": "bold"
      }
    },
    {
      "name": "PHP Namespace",
      "scope": [
        "support.other.namespace.php"
      ],
      "settings": {
        "foreground": "#5dbdc3",
        // "fontStyle": "bold"
      }
    },
    {
      "name": "PHP Entity Namespace",
      "scope": [
        "entity.name",
        "support.other.namespace.use.php",
        "meta.use.php",
      ],
      "settings": {
        "foreground": "#ff7d7d",
        // "fontStyle": "bold"
      }
    },
    {
      "name": "Support",
      "scope": [
        "support.class",
      ],
      "settings": {
        "foreground": "#2edccd",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Entity Types",
      "scope": [
        "support.type"
      ],
      "settings": {
        "foreground": "#ff6edb"
      }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": {
        "foreground": "#3cda93"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f5de8b"
      }
    },
    {
      "name": "Vue/HTML attribute strings",
      "scope": [
        "text.html.vue string.quoted",
        "text.html.vue meta.attribute string.quoted",
        "meta.attribute.directive.vue string.quoted",
        "text.html.derivative string.quoted.double.html",
        "text.html.derivative string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#7dceac"
      }
    },
    {
      "name": "Vue directives and bound props",
      "scope": [
        "entity.other.attribute-name.vue",
        "meta.attribute.directive.vue entity.other.attribute-name",
        "punctuation.attribute-shorthand.bind.html.vue",
        "punctuation.attribute-shorthand.event.html.vue"
      ],
      "settings": {
        "foreground": "#80d850",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vue properties",
      "scope": [
        "text.html.vue variable.other.property",
        "text.html.vue variable.other.object.property",
        "text.html.vue meta.object-literal.key",
        "source.vue variable.other.property",
        "source.vue meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#aeb89c"
      }
    },
    {
      "name": "CSS Classes",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#bedc83"
      }
    },
    {
      "name": "CSS ID's",
      "scope": [
        "source.sass keyword.control",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#86c7ff",
        // "fontStyle": "bold"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7aca04"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f48598"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#ad96ff"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ff7d7d"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff82ee"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*",
      ],
      "settings": {
        "fontStyle": "italic underline",
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#82aaff"
      }
    },
    {
      "name": "ES7 Bind Operator",
      "scope": [
        "source.js constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff8398"
      }
    },
